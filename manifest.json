{
  "manifestVersion": 2,
  "id": "session-insight-v2",
  "name": "会话用量",
  "version": "2.1.0",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "description": "会话用量可视化：tokens、缓存命中率、费用、余额，随当前会话切换，含完整数据面板。",
  "minAppVersion": "0.1013.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/sessions.read",
    "app/usage.read",
    "app/provider.credentials.read",
    "app/input.status",
    "app/resources.read",
    "app/models.read",
    "app/process.spawn"
  ],
  "network": {
    "allowedHosts": [
      "api.deepseek.com",
      "api.moonshot.cn",
      "api.github.com",
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "cdn.jsdelivr.net",
      "raw.githubusercontent.com",
      "open.bigmodel.cn",
      "api.z.ai",
      "management-api.x.ai",
      "api.openai.com",
      "chatgpt.com",
      "127.0.0.1",
      "localhost"
    ],
    "allowLocalhost": true,
    "methods": ["GET", "POST"],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 31457280
  },
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "会话用量·工作台",
        "description": "会话 Token、缓存命中率、费用与余额的完整数据面板，含逐轮图表与费用简报。",
        "route": "/panel.html",
        "cardForm": "flush",
        "titlebar": "translucent",
        "realization": "page",
        "siteNavEntry": true,
        "face": {
          "image": "assets/cover-workbench.webp"
        }
      },
      {
        "id": "widget",
        "title": "会话用量·实时用量",
        "description": "随当前会话切换的用量状态条，可放到画布上常驻。",
        "route": "/widget.html",
        "cardForm": "flush",
        "titlebar": "translucent",
        "face": {
          "image": "assets/cover-live.webp"
        }
      }
    ],
    "ui": {
      "inputStatus": [
        {
          "id": "hit",
          "title": "本轮缓存命中率",
          "text": "命中\u2009—\u2003"
        },
        {
          "id": "tps",
          "title": "输出吞吐速度",
          "text": "速度\u2009—\u2003"
        },
        {
          "id": "ttft",
          "title": "本轮首字耗时",
          "text": "首字\u2009—\u2003"
        },
        {
          "id": "tokens",
          "title": "本轮 Token 用量",
          "text": "用量\u2009—\u2003"
        },
        {
          "id": "cost",
          "title": "本轮费用",
          "text": "费用\u2009—\u2003"
        },
        {
          "id": "duration",
          "title": "本轮耗时",
          "text": "耗时\u2009—\u2003"
        }
      ]
    },
    "settings": {
      "title": "会话用量",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
