{
  "manifestVersion": 2,
  "id": "session-insight-v2",
  "name": "Session Insight",
  "version": "2.1.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "description": "会话用量可视化：tokens、缓存命中率、费用、余额，随当前会话切换，含完整数据面板。",
  "minAppVersion": "0.1013.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/sessions.read",
    "app/usage.read",
    "app/provider.credentials.read",
    "app/input.status",
    "app/resources.read"
  ],
  "network": {
    "allowedHosts": [
      "api.deepseek.com",
      "api.moonshot.cn",
      "api.github.com",
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "cdn.jsdelivr.net",
      "raw.githubusercontent.com",
      "open.bigmodel.cn",
      "api.z.ai",
      "management-api.x.ai",
      "api.openai.com",
      "chatgpt.com"
    ],
    "methods": ["GET", "POST"],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 31457280
  },
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "会话用量·工作台",
        "description": "会话 Token、缓存命中率、费用与余额的完整数据面板，含逐轮图表与费用简报。",
        "route": "/panel.html",
        "cardForm": "flush",
        "titlebar": "translucent",
        "realization": "page",
        "siteNavEntry": true,
        "face": {
          "image": "assets/cover.svg"
        }
      },
      {
        "id": "widget",
        "title": "会话用量·实时预览",
        "description": "随当前会话切换的用量状态条，可放到画布上常驻。",
        "route": "/widget.html",
        "cardForm": "flush",
        "titlebar": "translucent",
        "face": {
          "image": "assets/cover.svg"
        }
      }
    ],
    "ui": {
      "inputStatus": [
        {
          "id": "context",
          "title": "上下文",
          "text": "—"
        }
      ]
    },
    "settings": {
      "title": "Session Insight",
      "schema": {
        "type": "object",
        "properties": {
          "refreshSeconds": {
            "type": "integer",
            "title": "状态条刷新间隔（秒）",
            "description": "侧边状态条自动刷新频率。",
            "default": 30
          },
          "enableCodexQuota": {
            "type": "boolean",
            "title": "Codex 订阅配额（实验性）",
            "description": "读取已登录的 ChatGPT OAuth 配额；使用私有接口，默认关闭。",
            "default": false
          },
          "deepseekApiKey": {
            "type": "string",
            "title": "DeepSeek API Key（兜底）",
            "description": "仅在宿主凭据接口拿不到时用于余额查询，留空即可。",
            "default": "",
            "sensitive": true
          }
        }
      }
    }
  }
}
